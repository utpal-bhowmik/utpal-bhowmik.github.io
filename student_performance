            <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Average GPA</p>
            <h3 className="text-2xl md:text-3xl font-black text-emerald-400 mt-1">{metrics.avgGpa}</h3>
            <p className="text-[10px] text-emerald-500 mt-1">Scale of 0.00 - 4.00</p>
          </div>
          <div className="p-3 bg-emerald-500/10 text-emerald-400 rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
        </div>

        {/* Avg Attendance Card */}
        <div className="bg-slate-800/40 border border-slate-800 p-5 rounded-xl flex items-center justify-between shadow-lg">
          <div>
            <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Avg Attendance</p>
            <h3 className="text-2xl md:text-3xl font-black text-indigo-400 mt-1">{metrics.avgAttendance}%</h3>
            <p className="text-[10px] text-indigo-500 mt-1">Classroom engagement</p>
          </div>
          <div className="p-3 bg-indigo-500/10 text-indigo-400 rounded-lg">
            <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>

        {/* At Risk Card */}
        <div className="bg-slate-800/40 border border-slate-800 p-5 rounded-xl flex items-center justify-between shadow-lg">
          <div>
            <p className="text-xs font-semibold text-slate-400 uppercase tracking-wider">Students At Risk</p>
            <h3 className={`text-2xl md:text-3xl font-black mt-1 ${metrics.atRiskCount > 0 ? 'text-rose-400' : 'text-slate-400'}`}>
              {metrics.atRiskCount}
            </h3>
            <p className="text-[10px] text-slate-500 mt-1">GPA &lt; 2.5 or Att &lt; 75%</p>
          </div>
          <div className={`p-3 rounded-lg ${metrics.atRiskCount > 0 ? 'bg-rose-500/10 text-rose-400' : 'bg-slate-700/20 text-slate-500'}`}>
            <svg xmlns="http://www.w3.org/2000/svg" className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
        </div>

      </section>

      {/* Main Charts & Visualizations Area */}
      <section className="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
        
        {/* Visualization 1: Scatter Plot (Study Hours vs GPA) */}
        <div className="bg-slate-800/30 border border-slate-800 p-6 rounded-xl shadow-lg xl:col-span-2">
          <div className="flex justify-between items-start mb-6">
            <div>
              <h3 className="text-md font-bold text-white">Correlation Analysis</h3>
              <p className="text-xs text-slate-400">Study Hours (X-Axis) vs. Academic GPA (Y-Axis)</p>
            </div>
            <span className="text-[10px] bg-slate-700/60 border border-slate-700 px-2 py-1 rounded text-slate-300 font-semibold uppercase tracking-wider">
              Scatter Plot
            </span>
          </div>

          <div className="relative h-64 border-l border-b border-slate-700 ml-8 mb-6 mt-4">
            {/* Grid Lines */}
            <div className="absolute left-0 right-0 top-0 border-t border-slate-800/80"></div>
            <div className="absolute left-0 right-0 top-1/4 border-t border-slate-800/80"></div>
            <div className="absolute left-0 right-0 top-2/4 border-t border-slate-800/80"></div>
            <div className="absolute left-0 right-0 top-3/4 border-t border-slate-800/80"></div>

            {/* Y Axis Labels */}
            <div className="absolute -left-8 top-0 text-[10px] text-slate-500">4.0</div>
            <div className="absolute -left-8 top-1/4 text-[10px] text-slate-500">3.0</div>
            <div className="absolute -left-8 top-2/4 text-[10px] text-slate-500">2.0</div>
            <div className="absolute -left-8 top-3/4 text-[10px] text-slate-500">1.0</div>
            <div className="absolute -left-8 -bottom-1 text-[10px] text-slate-500">0.0</div>

            {/* X Axis Labels */}
            <div className="absolute left-0 -bottom-6 text-[10px] text-slate-500">0 hrs</div>
            <div className="absolute left-1/4 -bottom-6 -translate-x-1/2 text-[10px] text-slate-500">6.25 hrs</div>
            <div className="absolute left-2/4 -bottom-6 -translate-x-1/2 text-[10px] text-slate-500">12.5 hrs</div>
            <div className="absolute left-3/4 -bottom-6 -translate-x-1/2 text-[10px] text-slate-500">18.75 hrs</div>
            <div className="absolute right-0 -bottom-6 text-[10px] text-slate-500">25 hrs</div>

            {/* Plot Points */}
            {filteredData.map((student, i) => {
              // Convert values to percentages for relative absolute positioning
              // Study hours max 25, GPA max 4.0
              const xPercent = (student.studyHours / 25) * 100;
              const yPercent = 100 - (student.gpa / 4.0) * 100;

              return (
                <div
                  key={student.studentId}
                  className="absolute group cursor-pointer transform -translate-x-1/2 translate-y-1/2 z-10"
                  style={{ left: `${xPercent}%`, top: `${yPercent}%` }}
                  onClick={() => setSelectedStudent(student)}
                >
                  {/* Point */}
                  <div className={`w-3.5 h-3.5 rounded-full border-2 border-slate-900 shadow-md transition-all duration-150 group-hover:scale-150 ${
                    student.gpa >= 3.5 ? 'bg-emerald-400' :
                    student.gpa >= 2.5 ? 'bg-indigo-400' : 'bg-rose-500'
