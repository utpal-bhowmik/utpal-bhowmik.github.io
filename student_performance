                      <tr 
                        key={student.studentId}
                        className={`text-xs hover:bg-slate-800/40 transition duration-150 cursor-pointer ${isSelected ? 'bg-indigo-600/10 border-l-4 border-indigo-500' : ''}`}
                        onClick={() => setSelectedStudent(student)}
                      >
                        <td className="py-4 pl-3 font-mono font-bold text-white">{student.studentId}</td>
                        <td className="py-4 text-slate-300 font-medium">{student.major}</td>
                        <td className="py-4 text-center">
                          <span className={`px-2 py-0.5 rounded font-bold font-mono ${
                            student.gpa >= 3.5 ? 'text-emerald-400 bg-emerald-500/10' :
                            student.gpa >= 2.5 ? 'text-indigo-400 bg-indigo-500/10' : 'text-rose-400 bg-rose-500/10'
                          }`}>
                            {student.gpa.toFixed(2)}
                          </span>
                        </td>
                        <td className="py-4 text-center text-slate-300 font-mono">{student.attendance}%</td>
                        <td className="py-4 text-center text-slate-300 font-mono">{student.studyHours}h</td>
                        <td className="py-4">
                          <span className={`text-[10px] px-2 py-0.5 rounded-full font-semibold uppercase tracking-wider ${
                            student.tuition === 'Paid' ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' :
                            student.tuition === 'Pending' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' :
                            'bg-rose-500/10 text-rose-400 border border-rose-500/20'
                          }`}>
                            {student.tuition}
                          </span>
                        </td>
                        <td className="py-4 pr-3 text-right">
                          <button className="text-slate-500 hover:text-indigo-400 p-1 rounded hover:bg-slate-800 transition">
                            <svg xmlns="http://www.w3.org/2000/svg" className="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                          </button>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </div>

        {/* Quick Insights Side Drawer */}
        <div className="bg-slate-800/30 border border-slate-800 p-6 rounded-xl shadow-lg">
          <h3 className="text-md font-bold text-white mb-4 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" className="h-5 w-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 3.055A9.003 9.003 0 1020.945 13H11V3.055z" />
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z" />
            </svg>
            Selected Profile Analyzer
          </h3>

          {selectedStudent ? (
            <div className="space-y-6">
              
              {/* Profile Card Header */}
              <div className="bg-slate-900/60 p-4 rounded-xl border border-slate-850 text-center relative overflow-hidden">
                <div className="absolute top-0 right-0 p-2 text-slate-500 font-mono text-[9px]">
                  {selectedStudent.housing}
                </div>
                <div className="w-14 h-14 bg-indigo-600/20 text-indigo-400 rounded-full flex items-center justify-center mx-auto mb-3 font-mono font-bold text-lg border border-indigo-500/30">
                  {selectedStudent.studentId.slice(3)}
                </div>
                <h4 className="text-md font-black text-white">{selectedStudent.studentId}</h4>
                <p className="text-xs text-slate-400 mt-1 font-semibold">{selectedStudent.major}</p>
              </div>

              {/* Engagement vs Academic Performance Stats */}
              <div className="space-y-4">
                <h5 className="text-[10px] uppercase tracking-wider font-bold text-slate-400 border-b border-slate-850 pb-1">
                  Performance Dimensions
                </h5>

                {/* Grade Performance */}
                <div className="flex justify-between items-center text-xs">
                  <span className="text-slate-400">Grade Point Average</span>
                  <div className="flex items-center gap-2">
                    <span className="font-mono font-bold text-white">{selectedStudent.gpa.toFixed(2)}</span>
                    <span className={`text-[10px] px-1.5 py-0.5 rounded ${
                      selectedStudent.gpa >= 3.5 ? 'bg-emerald-500/15 text-emerald-400' :
                      selectedStudent.gpa >= 2.5 ? 'bg-indigo-500/15 text-indigo-400' : 'bg-rose-500/15 text-rose-400'
                    }`}>
                      {selectedStudent.gpa >= 3.5 ? 'Excellent' : selectedStudent.gpa >= 2.5 ? 'Good' : 'At-Risk'}
                    </span>
                  </div>
                </div>

                {/* Attendance */}
                <div className="flex justify-between items-center text-xs">
                  <span className="text-slate-400">Classroom Attendance</span>
                  <div className="flex items-center gap-2">
                    <span className="font-mono font-bold text-white">{selectedStudent.attendance}%</span>
                    <span className="text-[10px] text-indigo-400 font-semibold">Active</span>
                  </div>
                </div>

                {/* Weekly Study Hours */}
                <div className="flex justify-between items-center text-xs">
                  <span className="text-slate-400">Weekly Study Commits</span>
                  <span className="font-mono font-bold text-white">{selectedStudent.studyHours} hours</span>
                </div>

                {/* Logins & Visits */}
                <div className="grid grid-cols-2 gap-2 bg-slate-900/40 p-3 rounded-lg border border-slate-850 text-center">
                  <div>
                    <span className="block text-[10px] text-slate-400">LMS Logins / Wk</span>
                    <span className="block text-sm font-bold font-mono text-white mt-0.5">{selectedStudent.lmsLogins}</span>
                  </div>
                  <div className="border-l border-slate-850">
                    <span className="block text-[10px] text-slate-400">Library Visits / Mo</span>
                    <span className="block text-sm font-bold font-mono text-white mt-0.5">{selectedStudent.libraryVisits}</span>
                  </div>
                </div>
              </div>

              {/* Financial Check */}
              <div className="space-y-2">
                <h5 className="text-[10px] uppercase tracking-wider font-bold text-slate-400 border-b border-slate-850 pb-1">
                  Administrative Standings
                </h5>
                <div className="flex justify-between items-center text-xs">
                  <span className="text-slate-400">Tuition Payment Status</span>
                  <span className={`px-2 py-0.5 rounded font-semibold text-[10px] uppercase ${
                    selectedStudent.tuition === 'Paid' ? 'bg-emerald-500/10 text-emerald-400' :
                    selectedStudent.tuition === 'Pending' ? 'bg-amber-500/10 text-amber-400' :
                    'bg-rose-500/10 text-rose-400'
                  }`}>
                    {selectedStudent.tuition}
                  </span>
                </div>
              </div>

              {/* Action/Intervention Recommendation */}
              <div className="bg-indigo-900/10 border border-indigo-500/20 p-3.5 rounded-lg text-xs">
                <p className="font-semibold text-indigo-400">Intervention Notes:</p>
                <p className="text-slate-400 mt-1 text-[11px] leading-relaxed">
                  {selectedStudent.gpa < 2.5 
                    ? "Academic alert triggered. Recommend scheduling a 1-on-1 advisor review session focusing on self-study hours and class attendance." 
                    : "Outstanding status. The student meets all engagement expectations and satisfies required prerequisites."}
                </p>
              </div>

            </div>
          ) : (
            <div className="text-center py-12 text-slate-500">
              <svg xmlns="http://www.w3.org/2000/svg" className="mx-auto h-12 w-12 text-slate-700 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
              <p className="text-xs">No student selected.</p>
              <p className="text-[11px] text-slate-600 mt-1">Select any row from the student ledger directory to analyze detailed performance vectors.</p>
            </div>
          )}
        </div>

      </section>

    </div>
  );
}
